# Copy this file to migration.properties (git-ignored) and fill in real values.
# Run with: java -jar beneficiary-migration.jar --config=migration.properties

# --- Connection (required) ---
db.url=jdbc:sqlserver://HOST:1433;databaseName=fmb_mobile_banking;encrypt=true;trustServerCertificate=false
db.username=
db.password=

# --- Output ---
# Where the merged beneficiary_details.csv is written. A sibling <name>.warnings.log is
# written alongside it listing any rows that couldn't be fully resolved (missing bank_id,
# unrecognized transactionType, Botswana EFT rows with no valid branch, etc).
output=beneficiary_details_migrated.csv

# Where customer_info.csv (from dbo.Users) is written, with its own sibling warnings.log.
output.customerInfo=customer_info_migrated.csv

# Where transaction.csv (from dbo.Transactions) is written, with its own sibling warnings.log.
output.transactions=transaction_migrated.csv

# beneficiary_id values from PaymentBeneficiaries are offset by this amount so they can't
# collide with TransferBeneficiaries ids in the merged output.
payment.id.offset=900000000

# Uncomment to cap rows read per source table, e.g. for a dry run against a test DB.
# row.limit=100

# Only migrate Transactions from the last N months, counted from the run date (whole days, so
# a run on 30 Oct with the default of 3 starts at 30 Jul 00:00). Rows with no transactionDate are
# excluded. Set to 0 to migrate every transaction.
# transaction.months=3

# --- Source table names (override only if your schema differs from Migration_TableScripts.txt) ---
# users.table=dbo.Users
# transferBeneficiaries.table=dbo.TransferBeneficiaries
# paymentBeneficiaries.table=dbo.PaymentBeneficiaries
# bankBranches.table=dbo.BankBranches
# devices.table=dbo.Devices
# transactions.table=dbo.Transactions

# --- Banks table ---
# Defaults below match the confirmed schema: id, code, deleted, enabled, gatewayCode, name,
# processor, country_id, routingNumber, bankIBRefNumber, branchCode, hasBranches,
# allowsInstantTransfer, institution, shortName. There's no dedicated swiftCode column -
# gatewayCode holds the SWIFT/BIC-format value (e.g. "FMERMWMW", "BKIDBWGX"). institution is
# exactly 'BANK' or 'WALLET'; wallets only occur for Zambia banks. allowsInstantTransfer also
# drives the transaction dtype rules (Malawi/Zambia InterBankTransfer) and the beneficiary_type/
# wallet_type/bank_gateway_code rules. code (separate from gatewayCode) feeds wallet_type and
# bank_gateway_code for INSTANT rows. Run --describe-schema first if you're not sure your
# environment matches, and adjust these if it doesn't.
banks.table=dbo.Banks
banks.column.id=id
banks.column.name=name
banks.column.swiftCode=gatewayCode
banks.column.institution=institution
banks.column.allowInstantTransfer=allowsInstantTransfer
banks.column.code=code
# Any institution value containing this text (case-insensitive) is treated as a wallet.
banks.wallet.marker=WALLET

# --- Billers table ---
# Schema isn't documented either; biller_id -> gatewayCode decides a handful of transaction dtype
# rules (Malawi/Botswana BillPayment), and biller_id -> name feeds beneficiary_details.biller_name
# for PaymentBeneficiaries. Run --describe-schema to confirm the real column names and adjust if
# needed.
billers.table=dbo.Billers
billers.column.id=id
billers.column.gatewayCode=gatewayCode
billers.column.name=name

# --- Products table ---
# Schema isn't documented either; product_id -> gatewayCode decides the Malawi AirtimePurchase
# dtype rule (note: AirtimePurchase keys off product_id/Products, not biller_id/Billers, unlike
# BillPayment), and product_id -> name/gatewayCode feed beneficiary_details.wallet_type/wallet_code
# for the Malawi/Botswana PaymentBeneficiaries rows that resolve to IWL. Run --describe-schema to
# confirm the real column names and adjust if needed.
products.table=dbo.Products
products.column.id=id
products.column.gatewayCode=gatewayCode
products.column.name=name

# --- CountryPartner table ---
# Used only for customer_info.country_code / default_country_code, so this must resolve to a
# short code (e.g. "BW", "ZW"), not the full country name. Defaults to a "code" column; run
# --describe-schema to confirm the real column name and adjust if needed. (Not used for
# beneficiary_details or transaction.country_code anymore - those go through a fixed 1-4 table
# instead, see the README's Mapping notes.)
countryPartner.table=dbo.CountryPartner
countryPartner.column.id=id
countryPartner.column.name=code
